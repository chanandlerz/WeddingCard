# Cloudflare Pages headers
# Jika memakai custom domain Supabase, tambahkan domainnya ke connect-src.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; media-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co; frame-src https://challenges.cloudflare.com; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/music/*
  Cache-Control: public, max-age=604800

/header.png
  Cache-Control: public, max-age=86400

/admin
  Cache-Control: no-store
