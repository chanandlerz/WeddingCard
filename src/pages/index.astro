---
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import Hero from '../components/Hero.astro';
import Quote from '../components/Quote.astro';
import Couple from '../components/Couple.astro';
import Events from '../components/Events.astro';
import Gallery from '../components/Gallery.astro';
import Story from '../components/Story.astro';
import Gift from '../components/Gift.astro';
import Footer from '../components/Footer.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import RsvpWishForm from '../islands/RsvpWishForm';
import WishList from '../islands/WishList';
---

<Base locked>
  <Cover />

  <main id="main">
    <Hero />
    <Quote />
    <Couple />
    <Events />
    <Gallery />
    {/* <Story /> */}
    <Gift />

    <section id="ucapan" class="bg-paper-deep">
      <div class="section">
        <div class="text-center">
          <p class="eyebrow" data-reveal>RSVP &amp; Wishes</p>
          <h2 class="section-title mt-2" data-reveal>Wishes &amp; Prayers</h2>
          <p class="mt-3 text-sm text-ink-soft" data-reveal>
            Kindly confirm your attendance and share your warmest blessings for our new chapter.
          </p>
        </div>
        <div class="mt-8">
          <RsvpWishForm client:visible={{ rootMargin: '400px' }} />
          <WishList client:visible={{ rootMargin: '200px' }} />
        </div>
      </div>
    </section>

    <Footer />
  </main>

  <MusicPlayer />
</Base>

<script>
  import '../scripts/invite';
</script>
