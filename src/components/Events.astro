---
import { event } from '../config/event';
import { formatDate, formatTimeRange } from '../lib/time';
import { googleCalendarUrl } from '../lib/calendar';

const [first, second] = event.coupleOrder.map((k) => event[k].panggilan);
const r = event.resepsi;
const resepsiCal = googleCalendarUrl({
  title: `${r.judul} ${first} & ${second}`,
  start: r.mulai,
  end: r.selesai,
  location: `${r.tempat}, ${r.alamat}`,
  details: `Undangan pernikahan ${first} & ${second}.\n${new URL('/', Astro.site).href}`,
});

const iconMap =
  'M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21zm0-9a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z';
const iconCal = 'M7 3v3M17 3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z';
---

<section id="acara" class="bg-paper-deep">
  <div class="section text-center">
    <p class="eyebrow" data-reveal>Save the Date</p>
    <h2 class="section-title mt-2" data-reveal>Wedding Events</h2>

    <div class="mt-10 space-y-6">
      <!--
        Holy Matrimony (Akad): Populated via scripts/invite.ts if private session exists
      -->
      <article class="card hidden" data-akad-card data-reveal>
        <h3 class="font-script text-4xl font-normal">Holy Matrimony</h3>
        <div class="divider !my-4"></div>
        <p class="font-serif text-lg font-semibold" data-akad="tanggal"></p>
        <p class="mt-1 text-sm text-ink-soft" data-akad="waktu"></p>
        <p class="mt-4 font-semibold" data-akad="tempat"></p>
        <p class="mt-1 text-sm text-ink-soft" data-akad="alamat"></p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <a class="btn btn-primary" data-akad="maps" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={iconMap}></path></svg>
            View on Maps
          </a>
          <a class="btn btn-outline" data-akad="gcal" target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={iconCal}></path></svg>
            Add to Calendar
          </a>
        </div>
        <button type="button" class="mt-3 text-xs text-ink-soft underline underline-offset-4" data-akad="ics">
          Download Calendar File (.ics)
        </button>
      </article>

      <article class="card" data-resepsi-card data-reveal>
        <h3 class="font-script text-4xl font-normal">{r.judul}</h3>
        <div class="divider !my-4"></div>
        <p class="font-serif text-lg font-semibold">{formatDate(r.mulai)}</p>
        <p class="mt-1 text-sm text-ink-soft">{formatTimeRange(r.mulai, r.selesai)}</p>
        <p class="mt-4 font-semibold">{r.tempat}</p>
        <p class="mt-1 text-sm text-ink-soft">{r.alamat}</p>
        <div class="mt-6 flex flex-wrap justify-center gap-2">
          <a class="btn btn-primary" href={r.mapsUrl} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={iconMap}></path></svg>
            View on Maps
          </a>
          <a class="btn btn-outline" href={resepsiCal} target="_blank" rel="noopener noreferrer">
            <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d={iconCal}></path></svg>
            Add to Calendar
          </a>
        </div>
        <a href={`${import.meta.env.BASE_URL}resepsi.ics`} download class="mt-3 inline-block text-xs text-ink-soft underline underline-offset-4">
          Download Calendar File (.ics)
        </a>
      </article>
    </div>
  </div>
</section>
