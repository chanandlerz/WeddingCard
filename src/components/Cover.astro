---
import { Picture } from 'astro:assets';
import cover from '../assets/cover.jpg';
import { event } from '../config/event';
import { formatShortDate } from '../lib/time';

const [first, second] = event.coupleOrder.map((k) => event[k].panggilan);
---

<div
  id="cover"
  class="h-screen-safe fixed inset-0 z-50 flex flex-col items-center justify-end overflow-hidden text-center text-white transition-transform duration-1000 ease-[cubic-bezier(.7,0,.3,1)]"
  role="dialog"
  aria-modal="true"
  aria-labelledby="cover-title"
>
  <Picture
    src={cover}
    alt=""
    formats={['avif', 'webp']}
    widths={[480, 720, 1080]}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
    class="absolute inset-0 -z-10 h-full w-full object-cover"
  />
  <div class="absolute inset-0 -z-10 bg-gradient-to-b from-black/10 via-black/30 to-black/75"></div>

  <div class="w-full max-w-md px-8 pb-[max(3rem,env(safe-area-inset-bottom))]">
    <p class="eyebrow !text-white/80">The Wedding of</p>
    <h1 id="cover-title" class="mt-3 font-script text-6xl font-normal leading-tight">
      {first} <span class="text-4xl">&amp;</span> {second}
    </h1>
    <p class="mt-2 font-serif text-lg tracking-widest">{formatShortDate(event.resepsi.mulai)}</p>

    <div class="mx-auto mt-8 max-w-xs rounded-2xl bg-white/10 px-5 py-4 backdrop-blur-sm">
      <p class="text-sm text-white/80">Dear,</p>
      <!-- Populated via textContent by scripts/invite.ts. data-state: loading | ready -->
      <p class="mt-1 min-h-8 font-serif text-2xl font-semibold" data-guest-greeting data-state="loading">
        <span class="inline-block h-6 w-40 animate-pulse rounded bg-white/25 align-middle" aria-hidden="true"></span>
        <span class="sr-only">Loading guest name…</span>
      </p>
      <p class="mt-2 text-xs text-white/70">Please pardon any inaccuracies in name or title</p>
    </div>

    <button id="open-invitation" type="button" class="btn mt-8 bg-white text-ink shadow-lg hover:bg-paper">
      <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
        <path d="M3 7l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"></path>
      </svg>
      Open Invitation
    </button>
  </div>
</div>
