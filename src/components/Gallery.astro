---
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// Semua .jpg/.jpeg/.png/.webp di src/assets/gallery.
const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,webp}', {
  eager: true,
});

// Urutkan nomor file secara numerik (natural sort: 1, 2, 3... 9, 10, 11...)
const sortedKeys = Object.keys(modules).sort((a, b) => {
  const numA = parseInt(a.match(/\/(\d+)\.[^.]+$/)?.[1] ?? '0', 10);
  const numB = parseInt(b.match(/\/(\d+)\.[^.]+$/)?.[1] ?? '0', 10);
  return numA !== numB ? numA - numB : a.localeCompare(b);
});

const images = await Promise.all(
  sortedKeys.map(async (key, i) => {
    const src = modules[key].default;
    // Versi besar untuk lightbox (dimuat hanya saat diklik).
    const large = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 80 });
    return { src, large: large.src, alt: `Foto prewedding ${i + 1}`, index: i };
  }),
);
---

{
  images.length > 0 && (
    <section id="galeri" class="section">
      <div class="text-center">
        <p class="eyebrow" data-reveal>Our Moments</p>
        <h2 class="section-title mt-2" data-reveal>Galeri</h2>
      </div>

      <!-- Z-pattern grid: items appear row-by-row (left to right: 1, 2, then 3, 4) -->
      <div class="mt-8 grid grid-cols-2 gap-2.5">
        {images.map((img) => (
          <button
            type="button"
            class="group relative block aspect-[4/5] w-full overflow-hidden rounded-xl bg-ink/5"
            data-gallery-item
            data-index={img.index}
            data-large={img.large}
            data-alt={img.alt}
            aria-label={`Perbesar foto ${img.index + 1}`}
          >
            <Picture
              src={img.src}
              alt={img.alt}
              formats={['avif', 'webp']}
              widths={[240, 400, 640]}
              sizes="(max-width: 448px) 50vw, 220px"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
            />
          </button>
        ))}
      </div>

      <!-- Lightbox modal with swipe and prev/next -->
      <dialog
        id="lightbox"
        class="fixed inset-0 m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/92 select-none outline-none"
        aria-label="Foto galeri"
      >
        <div class="h-screen-safe relative flex w-screen items-center justify-center p-2 sm:p-6">
          <button
            type="button"
            id="lightbox-close"
            class="absolute right-4 top-[max(1rem,env(safe-area-inset-top))] z-20 inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/20 text-white backdrop-blur hover:bg-white/30 transition"
            aria-label="Tutup"
          >
            ✕
          </button>

          <!-- Prev Button -->
          <button
            type="button"
            id="lightbox-prev"
            class="absolute left-2 top-1/2 -translate-y-1/2 z-20 inline-flex h-11 w-11 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur hover:bg-black/60 transition"
            aria-label="Foto sebelumnya"
          >
            ‹
          </button>

          <!-- Next Button -->
          <button
            type="button"
            id="lightbox-next"
            class="absolute right-2 top-1/2 -translate-y-1/2 z-20 inline-flex h-11 w-11 items-center justify-center rounded-full bg-black/40 text-white backdrop-blur hover:bg-black/60 transition"
            aria-label="Foto selanjutnya"
          >
            ›
          </button>

          <!-- Image Container with touch listeners -->
          <div id="lightbox-container" class="relative max-h-full max-w-full flex items-center justify-center touch-pan-y">
            <img
              id="lightbox-img"
              alt=""
              class="max-h-[85dvh] max-w-[92vw] rounded-xl object-contain shadow-2xl transition-transform duration-200"
              decoding="async"
            />
          </div>

          <!-- Counter indicator -->
          <div class="absolute bottom-[max(1rem,env(safe-area-inset-bottom))] left-1/2 -translate-x-1/2 z-20 rounded-full bg-black/50 px-3 py-1 text-xs text-white/80 backdrop-blur">
            <span id="lightbox-counter">1 / 1</span>
          </div>
        </div>
      </dialog>
    </section>
  )
}

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement | null;
  const img = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const closeBtn = document.getElementById('lightbox-close');
  const prevBtn = document.getElementById('lightbox-prev');
  const nextBtn = document.getElementById('lightbox-next');
  const counter = document.getElementById('lightbox-counter');
  const container = document.getElementById('lightbox-container');

  const items = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-gallery-item]'));
  const galleryData = items.map((btn) => ({
    large: btn.dataset.large ?? '',
    alt: btn.dataset.alt ?? '',
  }));

  let currentIndex = 0;

  function showPhoto(index: number) {
    if (!dialog || !img || galleryData.length === 0) return;
    currentIndex = (index + galleryData.length) % galleryData.length;
    const data = galleryData[currentIndex];
    img.src = data.large;
    img.alt = data.alt;
    if (counter) counter.textContent = `${currentIndex + 1} / ${galleryData.length}`;
  }

  items.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      if (!dialog || !img) return;
      if (typeof dialog.showModal !== 'function') {
        window.open(btn.dataset.large, '_blank');
        return;
      }
      showPhoto(idx);
      dialog.showModal();
    });
  });

  prevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex - 1);
  });

  nextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    showPhoto(currentIndex + 1);
  });

  closeBtn?.addEventListener('click', () => dialog?.close());

  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog || (e.target as HTMLElement).id === 'lightbox-close') {
      dialog.close();
    }
  });

  // Keyboard navigation (Arrow keys + Esc)
  window.addEventListener('keydown', (e) => {
    if (!dialog?.open) return;
    if (e.key === 'ArrowLeft') showPhoto(currentIndex - 1);
    if (e.key === 'ArrowRight') showPhoto(currentIndex + 1);
  });

  // Touch Swipe Gesture (Mobile swipe left & right)
  let touchStartX = 0;
  let touchEndX = 0;
  let touchStartY = 0;
  let touchEndY = 0;

  dialog?.addEventListener(
    'touchstart',
    (e) => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    },
    { passive: true },
  );

  dialog?.addEventListener(
    'touchend',
    (e) => {
      touchEndX = e.changedTouches[0].clientX;
      touchEndY = e.changedTouches[0].clientY;
      handleSwipe();
    },
    { passive: true },
  );

  function handleSwipe() {
    const diffX = touchEndX - touchStartX;
    const diffY = touchEndY - touchStartY;
    // Only trigger if horizontal swipe is prominent
    if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY) * 1.5) {
      if (diffX < 0) {
        // Swiped left -> next
        showPhoto(currentIndex + 1);
      } else {
        // Swiped right -> prev
        showPhoto(currentIndex - 1);
      }
    }
  }
</script>
