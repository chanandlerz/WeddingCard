</section>

<script>
  const openBtn = document.getElementById('open-qris-modal');
  const modal = document.getElementById('qris-modal') as HTMLDialogElement | null;
  const closeBtn = document.getElementById('close-qris-modal');
  const dismissBtn = document.getElementById('dismiss-qris-btn');

  if (openBtn && modal) {
    openBtn.addEventListener('click', () => {
      modal.showModal();
    });

    const closeModal = () => modal.close();
    closeBtn?.addEventListener('click', closeModal);
    dismissBtn?.addEventListener('click', closeModal);

    // Close when clicking backdrop
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        modal.close();
      }
    });
  }
</script>
