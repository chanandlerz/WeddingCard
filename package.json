{
  "name": "wedding-card",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test:sql": "node tests/sql.test.mjs",
    "test:filter": "node --experimental-strip-types tests/profanity.test.ts",
    "placeholders": "node scripts/gen-placeholders.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "fn:serve": "supabase functions serve submit-wish --env-file supabase/functions/.env",
    "fn:deploy": "supabase functions deploy submit-wish --no-verify-jwt",
    "deploy": "astro build && gh-pages -d dist --dotfiles"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.3",
    "preact": "^10.29.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.8",
    "gh-pages": "^6.3.0",
    "supabase": "^2.117.0",
    "typescript": "^6.0.3"
  }
}
